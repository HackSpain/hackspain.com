DATABASE_URL=
# Optional: https://discord.com/api/webhooks/... (new signup notifications)
DISCORD_WEBHOOK_URL=
# Sentry: public DSN (same in browser; set in Vercel for production)
PUBLIC_SENTRY_DSN=
# Sentry: auth token for source map upload during build (generate at sentry.io)
SENTRY_AUTH_TOKEN=

# Resend: transactional email delivery (server-only)
RESEND_API_KEY=
RESEND_FROM="HackSpain <noreply@updates.hackspain.com>"

# Server-only: included only in the welcome email sent after approval.
WHATSAPP_COMMUNITY_URL=
# Public website origin used to build personalized signup links.
SITE_URL=https://hackspain.com
