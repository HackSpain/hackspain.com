DATABASE_URL=
# Sentry: public DSN (same in browser; set in Vercel for production)
PUBLIC_SENTRY_DSN=
# Sentry: auth token for source map upload during build (generate at sentry.io)
SENTRY_AUTH_TOKEN=

# Resend: transactional email delivery (server-only)
RESEND_API_KEY=
RESEND_FROM="HackSpain <noreply@updates.hackspain.com>"

# Public website origin used to build transactional email links.
SITE_URL=

# Invite link to the attendees' WhatsApp group, offered on /confirmacion once a
# place is confirmed. Leave empty and the button is simply not shown.
PUBLIC_WHATSAPP_GROUP_URL=https://hackspain.com
